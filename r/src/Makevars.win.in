TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

# Make needs escaped spaces in targets; the shell needs quoted paths in recipes.
empty =
space = $(empty) $(empty)

TARGET_DIR = $(or $(CARGO_TARGET_DIR),./rust/target)
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libckdata_r.a
STATLIB_TARGET = $(subst $(space),\$(space),$(STATLIB))
PKG_LIBS = -L"$(LIBDIR)" -lckdata_r -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB_TARGET) rust_clean clean

$(SHLIB): $(STATLIB_TARGET)

$(STATLIB_TARGET):
	mkdir -p "$(TARGET_DIR)/libgcc_mock"
	touch "$(TARGET_DIR)/libgcc_mock/libgcc_eh.a"

	@set -eu; \
	if [ -z "$(CARGO_HOME)" ]; then \
		CARGO_HOME=$$(mktemp -d "$(CURDIR)/.ckdata-cargo.XXXXXX"); \
		export CARGO_HOME; \
		trap 'rm -rf "$$CARGO_HOME"' EXIT HUP INT TERM; \
	else \
		export CARGO_HOME="$(CARGO_HOME)"; \
	fi; \
	set --; \
	if [ -d ./vendor ]; then \
		echo "=== Using offline vendor directory ==="; \
		set -- --config rust/vendor-config.toml; \
	elif [ -f ./rust/vendor.tar.xz ]; then \
		echo "=== Using offline vendor tarball ==="; \
		tar xf rust/vendor.tar.xz; \
		touch .ckdata-vendor-created; \
		set -- --config rust/vendor-config.toml; \
	fi; \
	export PATH="$(PATH):$(HOME)/.cargo/bin"; \
		export LIBRARY_PATH="$(LIBRARY_PATH);$$(cd "$(TARGET_DIR)" && pwd -P)/libgcc_mock"; \
	export @PANIC_EXPORTS@RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs"; \
	cargo build "$$@" --locked @CRAN_FLAGS@ --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir "$(TARGET_DIR)" --target=$(TARGET); \
	cargo run "$$@" --locked @CRAN_FLAGS@ --bin document @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir "$(TARGET_DIR)" --target=$(TARGET)

rust_clean: $(SHLIB)
	@if [ -f .ckdata-vendor-created ]; then rm -rf ./vendor .ckdata-vendor-created; fi
	rm -rf @CLEAN_TARGET@

clean:
	@if [ -f .ckdata-vendor-created ]; then rm -rf ./vendor .ckdata-vendor-created; fi
	rm -rf "$(SHLIB)" $(OBJECTS) $(if $(CARGO_TARGET_DIR),,"$(TARGET_DIR)")
