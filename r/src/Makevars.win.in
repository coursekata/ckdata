TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu
RUST_LIBDIR = $(TARGET)/@LIBDIR@
RUST_TARGET = --target=$(TARGET)
RUST_CRAN_FLAGS = @CRAN_FLAGS@
RUST_PROFILE = @PROFILE@
RUST_PANIC_EXPORTS = @PANIC_EXPORTS@
RUST_CLEAN_TARGET = @CLEAN_TARGET@
RUST_PLATFORM_LIBS = -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll
RUST_PREPARE = mkdir -p "$(TARGET_DIR)/libgcc_mock"; \
	touch "$(TARGET_DIR)/libgcc_mock/libgcc_eh.a"; \
	export LIBRARY_PATH="$(LIBRARY_PATH);$$(cd "$(TARGET_DIR)" && pwd -P)/libgcc_mock"

include Makevars.common
